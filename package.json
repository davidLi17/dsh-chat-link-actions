{
  "name": "dsh-chat-link-actions",
  "version": "0.5.6",
  "description": "Right-click actions on file links in the DSH transcript: quote the path into the composer, or reveal the file in the OS file manager. Menus are drawn in the app's own style, never the system one.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "PROTOCOL.md",
    "README.md",
    "cli.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "index.js",
    "protocol.json"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "link-actions",
    "file-link",
    "quote-path",
    "reveal-in-finder"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "author": {
    "name": "regrevia",
    "url": "https://github.com/regrevia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-chat-link-actions.git"
  },
  "homepage": "https://github.com/regrevia/dsh-chat-link-actions#readme",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-chat-link-actions/issues"
  },
  "scripts": {
    "test": "node --test test/index.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "bin": {
    "dsh-chat-link-actions": "./cli.js"
  }
}
