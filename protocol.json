{
  "version": 2,
  "storage": {
    "file": "~/.dsh/chat-link-actions/custom-actions.json",
    "shape": "{ \"version\": 1, \"actions\": [ { \"label\": string, \"kind\": Kind, \"value\": string } ] }",
    "note": "菜单与 CLI 共用这个文件。写完 5 秒内界面自己刷新，不用重启、不用刷新页面。"
  },
  "limits": {
    "entries": 20,
    "label": 40,
    "value": 400,
    "note": "超出上限时写入被拒绝并报错，不会截断。"
  },
  "placeholders": [
    "{path}",
    "{dir}",
    "{name}",
    "{url}"
  ],
  "kinds": [
    {
      "kind": "shell",
      "value": "命令行模板，占位符会被正确加引号",
      "effect": "跑这条命令，自己决定发去哪",
      "example": {
        "label": "传到服务器",
        "kind": "shell",
        "value": "scp {path} phone:/tmp/"
      }
    },
    {
      "kind": "powershell",
      "value": "PowerShell 脚本模板，占位符会变成单引号字面量",
      "platform": "win32",
      "effect": "用 Windows PowerShell 5.1 跑这段脚本，不读 profile、不交互",
      "example": {
        "label": "导出到桌面",
        "kind": "powershell",
        "value": "Copy-Item -LiteralPath {path} -Destination \"$env:USERPROFILE\\Desktop\""
      }
    },
    {
      "kind": "pwsh",
      "value": "PowerShell 脚本模板，占位符会变成单引号字面量",
      "effect": "用 PowerShell 7+（pwsh）跑这段脚本；两者脚本写法一致，差别只在版本",
      "example": {
        "label": "列出目录",
        "kind": "pwsh",
        "value": "Get-ChildItem -LiteralPath {dir}"
      }
    },
    {
      "kind": "app",
      "value": "App 名称（macOS）或可执行文件路径（Windows）",
      "effect": "用这个 App 打开文件",
      "example": {
        "label": "用预览打开",
        "kind": "app",
        "value": "Preview"
      }
    },
    {
      "kind": "shortcut",
      "platform": "darwin",
      "value": "快捷指令名称",
      "effect": "用文件当输入跑一遍这个快捷指令",
      "example": {
        "label": "存到手机",
        "kind": "shortcut",
        "value": "存到手机"
      }
    },
    {
      "kind": "url",
      "value": "带占位符的链接",
      "effect": "把占位符替换并编码后打开这条链接，交给注册了该协议的 App",
      "example": {
        "label": "发送到小米手机",
        "kind": "url",
        "value": "mi://send?p={path}"
      }
    },
    {
      "kind": "share",
      "platform": "darwin",
      "value": "",
      "effect": "弹出系统分享面板，让用户在面板里选目标",
      "example": {
        "label": "系统分享",
        "kind": "share",
        "value": ""
      }
    },
    {
      "kind": "service",
      "platform": "darwin",
      "value": "原生分享服务的标题，例如 发送到微信",
      "effect": "把文件直接交给那个 App 的分享扩展，不弹面板",
      "example": {
        "label": "发送到微信",
        "kind": "service",
        "value": "发送到微信"
      }
    }
  ],
  "http": {
    "base": "/chat-link-actions",
    "fenced": "只接受 DSH 页面发起的请求",
    "routes": [
      {
        "action": "protocol",
        "method": "POST",
        "body": null,
        "returns": "这份协议本身"
      },
      {
        "action": "actions-get",
        "method": "POST",
        "body": null,
        "returns": "{ actions }"
      },
      {
        "action": "actions-detect",
        "method": "POST",
        "body": null,
        "returns": "{ targets: 本机可用的 target[] }"
      },
      {
        "action": "actions-add",
        "method": "POST",
        "body": "{ actions: entry[], replace?: boolean }",
        "returns": "{ actions }"
      },
      {
        "action": "actions-remove",
        "method": "POST",
        "body": "{ labels: string[] }",
        "returns": "{ actions }"
      },
      {
        "action": "actions-save",
        "method": "POST",
        "body": "{ actions: entry[] }",
        "returns": "{ actions }"
      },
      {
        "action": "actions-run",
        "method": "POST",
        "body": "{ label, path?, url? }",
        "returns": "{ ok }"
      }
    ]
  },
  "cli": [
    "node <plugin>/cli.js protocol",
    "node <plugin>/cli.js detect",
    "node <plugin>/cli.js apply --json '[{\"label\":\"用 WPS 打开\",\"kind\":\"app\",\"value\":\"WPS\"}]'",
    "node <plugin>/cli.js apply --file /tmp/menu.json --replace true",
    "node <plugin>/cli.js validate --json '[...]'",
    "node <plugin>/cli.js list",
    "node <plugin>/cli.js add --label 发送到微信 --kind share --value \"\"",
    "node <plugin>/cli.js remove 发送到微信",
    "node <plugin>/cli.js run 用 WPS 打开 --path /tmp/a.png"
  ],
  "agent": {
    "intent": "按用户的说法把入口配好：先读懂他要「用哪个 App / 发到哪 / 跑什么」，再选 kind，最后一次 apply 写入。",
    "fast_path": [
      "node <plugin>/cli.js detect  → 看本机有哪些 App 和快捷指令，拿现成 value",
      "node <plugin>/cli.js apply --json '[{\"label\":\"用 WPS 打开\",\"kind\":\"app\",\"value\":\"WPS\"}]'",
      "node <plugin>/cli.js list → 确认最终入口"
    ],
    "rules": [
      "label 是用户在菜单里看到的字，写动词短语，例如「用 WPS 打开」「发送到微信」。",
      "同名 label 视为同一条：apply 会覆盖，不会长出重复项，所以重跑是安全的。",
      "kind 只能是 kinds 里列出的值；不认识的 kind 会被当成 shell，不要依赖这个兜底。",
      "app 的 value 用 App 名字（WPS、Preview）或 .app 的完整路径；Windows 用 exe 路径。",
      "share 的 value 必须是空字符串；它弹系统面板，具体发给谁由用户在面板里选。",
      "shell 里放占位符 {path} {dir} {name} {url}，它们会被正确加引号；不要把路径硬编码。",
      "一次配 1 到 3 条就够。菜单是给人快速点的，堆满反而难用。",
      "写完不要叫用户重启或刷新页面；最多说「已经配好了」。"
    ],
    "recipes": [
      {
        "ask": "用 WPS 打开",
        "entry": {
          "label": "用 WPS 打开",
          "kind": "app",
          "value": "WPS"
        }
      },
      {
        "ask": "用某个 App 打开（不知道装没装）",
        "entry": {
          "label": "用预览打开",
          "kind": "app",
          "value": "Preview"
        }
      },
      {
        "ask": "发送到微信 / 发给别人",
        "entry": {
          "label": "发送到…",
          "kind": "share",
          "value": ""
        }
      },
      {
        "ask": "跑一条现成命令（压缩、转格式、传服务器）",
        "entry": {
          "label": "转成 PNG",
          "kind": "shell",
          "value": "sips -s format png {path} --out {dir}/"
        }
      },
      {
        "ask": "存到手机 / 某个 App 的协议",
        "entry": {
          "label": "发送到手机",
          "kind": "url",
          "value": "mi://send?p={path}"
        }
      }
    ],
    "errors": {
      "too-many-entries": "条目超过上限，先删几条",
      "label-too-long": "label 超过 40 字",
      "value-too-long": "value 超过 400 字",
      "control-character": "label 或 value 里有不可见控制字符"
    }
  }
}
